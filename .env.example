# CampusTrade 容器编排环境变量模板
# 使用方法：复制本文件为 .env 并填入真实密码
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会提交到 GitHub，请勿填写真实密码后提交。

# 应用数据库名与业务账号
DB_NAME=campustrade
DB_USER=campustrade

# 业务账号密码（应用连接使用）—— 必填
DB_PASSWORD=choose-a-strong-password

# MySQL root 密码（健康检查使用）—— 必填，与上面不要相同
MYSQL_ROOT_PASSWORD=choose-a-root-password

# Week 07: generate private values with python scripts/nacos-admin.py prepare.
NACOS_AUTH_TOKEN=REPLACE_WITH_BASE64_SECRET_AT_LEAST_32_BYTES
NACOS_AUTH_IDENTITY_KEY=REPLACE_WITH_SERVER_IDENTITY_KEY
NACOS_AUTH_IDENTITY_VALUE=REPLACE_WITH_SERVER_IDENTITY_VALUE
NACOS_USERNAME=nacos
NACOS_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
NACOS_GROUP=PERSONAL_GROUP
NACOS_NAMESPACE=
NACOS_CONSOLE_PORT=18080
NACOS_SERVER_PORT=18849
NACOS_GRPC_PORT=19849
