# CampusTrade 容器编排环境变量模板
# 使用方法：复制本文件为 .env 并填入真实密码
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会提交到 GitHub，请勿填写真实密码后提交。

# 应用数据库名与业务账号
DB_NAME=campustrade
DB_USER=campustrade

# 业务账号密码（应用连接使用）—— 必填
DB_PASSWORD=choose-a-strong-password

# MySQL root 密码（健康检查使用）—— 必填，与上面不要相同
MYSQL_ROOT_PASSWORD=choose-a-root-password
